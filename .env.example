# Public browser configuration. These values are not secrets, but production
# values should still be supplied through the deployment environment.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public OAuth client identifier used by Google Identity Services.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only configuration. Never prefix these values with NEXT_PUBLIC_ and
# never commit populated values. The secret key is required only for account
# deletion and should be scoped to the production Supabase project.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
